+                    for mesh in model['links'][name]['meshes']:
+                        world=mesh['vertices_local_m']@rot.T+p
+                        faces=mesh['convex_hull_faces_input'] if mesh['approximation_authored']=='convexHull' else mesh['faces']
+                        for c in collisions:
