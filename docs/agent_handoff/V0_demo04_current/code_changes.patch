+        mesh.GetExtentAttr().Set([Gf.Vec3f(*local.min(axis=0)), Gf.Vec3f(*local.max(axis=0))])
+        if g["normals_authored"]:
+            raise ValueError("Source gained authored normals; affine inverse-transpose handling required")
