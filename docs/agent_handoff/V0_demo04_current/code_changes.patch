+    final = read_geometry(reload)
+    mass_written = usd_mass_snapshot(reload)
+    max_errors, z_errors, unchanged_topology, unchanged_parameters = [], [], [], []
+    for record in records:
+        path = record["path"]
+        src, dst = original[path], final[path]
