+    after = integrate_material(transformed["body_points"], transformed["faces"])
+    affine_q = np.diag(SCALE) @ before["central_second_moment_m2"] @ np.diag(SCALE)
+    affine_i = MASS_KG * (np.trace(affine_q) * np.eye(3) - affine_q)
